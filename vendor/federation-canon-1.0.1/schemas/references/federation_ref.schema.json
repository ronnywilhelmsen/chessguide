{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://federation.creator.local/schemas/references/federation_ref/1.0.0",
  "title": "FederationRef",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "federation_ref_id",
    "publisher_sovereign_id",
    "target_sovereign_id",
    "target_type",
    "target_id",
    "target_schema_version",
    "target_checksum",
    "published_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "fed/ref/1.0.0"
    },
    "federation_ref_id": {
      "type": "string",
      "format": "uuid"
    },
    "publisher_sovereign_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "target_sovereign_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "target_type": {
      "type": "string",
      "enum": ["observation"]
    },
    "target_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_schema_version": {
      "type": "string",
      "pattern": "^(oat|fed)/[a-z_]+/[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "target_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
