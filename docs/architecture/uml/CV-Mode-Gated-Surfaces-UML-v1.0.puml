' =====================================================================
' Diagram 2: Component diagram
' =====================================================================
@startuml CV_Mode_Gated_Surfaces_Component_Diagram
title CV + Mode-Gated Surfaces - Component Diagram (Draft LLD)

component "Android Surface\n(AndroidCVCaptureSurface)" as Android
component "WebLiveDisplaySurface" as Web
component "TheWilhelmsenSurfaceAdapter" as TW
component "ChromeReviewImportAdapter" as Chrome
component "ModeGate" as Gate
component "DeterministicPositionValidator" as Validator
component "TSS/SCC Adapter\n(TssSccReviewAdapter)" as TSS
component "Engine Adapter\n(EngineReferenceAdapter)" as Engine
component "Buddy Adapter\n(BuddyOutputAdapter)" as Buddy
component "Creator Replay\n(CreatorReplayEnvelope)" as Replay
component "Federation Withholding\n(FederationWithholdingGuard)" as Fed

Android --> Validator : candidate FEN draft
Android --> Gate : ModeGateRequest
Chrome --> Validator : imported PGN/FEN
Chrome --> Gate : ModeGateRequest
Web --> Gate : display request
TW --> Gate : hosted display request
Gate --> TSS : gated scan request
Gate --> Engine : gated reference request
Gate --> Buddy : gated explanation request
Validator --> Gate : validation state
Gate --> Web : allowed payload
Gate --> TW : allowed payload (governed)
Gate --> Replay : decision + suppression
Replay --> Fed : continuity record
Fed ..> Fed : withhold semantic data

note bottom of TW
  thewilhelmsen.com is an internal related project
  (ronnywilhelmsen/thewilhelmsen.com).
  Hosted surface only; cannot bypass ModeGate.
  Not modified in this PR.
end note
@enduml

' =====================================================================
' Diagram 3: Sequence diagram - Android capture in Competition Mode
' =====================================================================
@startuml CV_Mode_Gated_Surfaces_Sequence_Android_Competition
title Sequence - Android Capture in Competition Mode (display/record only)

actor Player
participant "AndroidCVCaptureSurface" as A
participant "CVCaptureCoordinator" as C
participant "BoardDetector" as B
participant "ConfidenceThresholdPolicy" as Conf
participant "DeterministicPositionValidator" as V
participant "ModeGate" as G
participant "CompetitionModeGuard" as CG
participant "WebLiveDisplaySurface" as W
participant "CreatorReplayEnvelope" as R
participant "FederationWithholdingGuard" as F

Player -> A : captureFrame(request[COMPETITION])
A -> C : capture(request)
C -> B : detectBoard(frame, context)
B --> C : BoardDetectionResult (draft)
C -> Conf : evaluate(envelope, BOARD_IMAGE)
Conf --> C : ConfidenceDecision
C -> V : validateFen(request)
V --> C : PositionValidationResult
C -> G : evaluate(ModeGateRequest)
G -> CG : evaluate(request)
CG --> G : suppress advice (DISPLAY_ONLY)
G --> W : allowedOutputs {board, clock, moves, status}
W --> Player : live display (no advice)
G -> R : fromModeDecision(decision, event)
R -> F : evaluate(FederationExportRequest)
F --> R : withhold semantic data
note right of CG
  Suppressed: engine, TSS/CCT, Buddy,
  model output, Learning Frontier
end note
@enduml

' =====================================================================
' Diagram 4: Sequence diagram - Learning/Review flow
' =====================================================================
@startuml CV_Mode_Gated_Surfaces_Sequence_Learning_Review
title Sequence - Learning / Review Flow (guarded pedagogy)

actor Learner
participant "AndroidCVCaptureSurface\nor ChromeReviewImportAdapter" as Src
participant "DeterministicPositionValidator" as V
participant "ModeGate" as G
participant "LearningModeGuard\nor ReviewModeGuard" as LG
participant "TssSccReviewAdapter" as TSS
participant "KgConceptReadAdapter" as KG
participant "LearningFrontierReadAdapter" as LF
participant "BuddyOutputAdapter" as B
participant "CreatorReplayEnvelope" as R

Learner -> Src : capture / import (LEARNING or REVIEW)
Src -> V : validate position
V --> Src : VALIDATED
Src -> G : evaluate(ModeGateRequest)
G -> LG : evaluate(request)
LG --> G : LEARNING_ALLOWED / REVIEW_ONLY
G -> TSS : requestScan(request, decision)
TSS --> G : Optional<TssSccResultRef>
G -> KG : readConcept(conceptRef)
KG --> G : KgConceptView
G -> LF : readFrontier(learnerId, decision)
LF --> G : Optional<LearningFrontierView>
G -> B : requestExplanation(request, activationState, decision)
B --> G : Optional<BuddyExplanationDraft> (only if ACTIVE + gates)
G -> R : record pedagogy + suppression
note right of B
  Buddy returns empty unless BLAP gates pass.
  No mastery claims. Uncertainty preserved.
end note
@enduml

' =====================================================================
' Diagram 5: Sequence diagram - thewilhelmsen.com live display
' =====================================================================
@startuml CV_Mode_Gated_Surfaces_Sequence_TheWilhelmsen_Display
title Sequence - thewilhelmsen.com Live Display (hosted, governed)

actor Spectator
participant "WebLiveDisplaySurface" as W
participant "TheWilhelmsenSurfaceAdapter" as TW
participant "TheWilhelmsenGovernanceBoundary" as GB
participant "ModeGate" as G
participant "BroadcastDisplayGuard" as BG
participant "CreatorReplayEnvelope" as R

Spectator -> W : open live display (BROADCAST_DISPLAY)
W -> TW : preparePayload(payload, decision)
TW -> GB : assertNoIndependentAdvice(payload)
GB --> TW : BoundaryCheckResult (ok)
TW -> G : evaluate(ModeGateRequest)
G -> BG : evaluate(request)
BG --> G : DISPLAY_ONLY + no-advice banner
G --> TW : allowedOutputs {board, clock, moves, status}
TW --> Spectator : hosted live display (no advice)
G -> R : record display decision + suppression
note right of GB
  thewilhelmsen.com cannot become an
  independent source of chess advice.
  Not modified in this PR.
end note
@enduml
